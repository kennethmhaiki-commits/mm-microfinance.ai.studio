  "firestore": {
    "/companySettings/{settingId}": {
      "schema": { "$ref": "#/entities/CompanySettings" },
      "description": "Microfinance company configuration documents."
    },
    "/loanTypes/{typeId}": {
      "schema": { "$ref": "#/entities/LoanType" },
      "description": "Loan product definitions offered by the microfinance."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Registered microfinance borrowers and their guarantors."
    },
    "/loans/{loanId}": {
      "schema": { "$ref": "#/entities/Loan" },
      "description": "Issued microfinance loans linked to customers."
    },
    "/repayments/{repaymentId}": {
      "schema": { "$ref": "#/entities/Repayment" },
      "description": "Collected loan repayments and receipt records."
    },
    "/messageLogs/{logId}": {
      "schema": { "$ref": "#/entities/MessageLog" },
      "description": "Customer communication log for WhatsApp, SMS, and social reminders."
    },
    "/loanApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/LoanApplication" },
      "description": "Online loan applications submitted by borrowers awaiting staff approval."
    },
    "/bankDebitTransactions/{txId}": {
      "schema": { "$ref": "#/entities/BankDebitTransaction" },
      "description": "Direct bank debit and government payroll check-number deduction audit records."
    },
    "/staffAccounts/{staffId}": {
      "schema": { "$ref": "#/entities/StaffAccount" },
      "description": "Staff accounts with hashed credentials, lock/unlock controls, and activated permission levels."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/DailyTask" },
      "description": "Daily operational task reminders created and completed by admins and staff."
    }
  }
}
