{
  "entities": {
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Configuration and profile details for the microfinance company.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning account."
        },
        "companyName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Main company display name."
        },
        "contractOrgName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Organization header used in official contracts."
        },
        "district": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "District name for the company and contract header."
        },
        "region": {
          "type": "string",
          "maxLength": 80,
          "description": "Region or street address."
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30,
          "description": "Official company phone number."
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Official company email address."
        },
        "lenderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Lender full name printed on contracts."
        },
        "lenderWitnessName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Lender witness full name printed on contracts."
        },
        "defaultPenaltyPercent": {
          "type": "number",
          "description": "Default late payment penalty percentage."
        },
        "paymentChannelsNote": {
          "type": "string",
          "maxLength": 300,
          "description": "Payment account numbers and mobile money instructions."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "ownerId",
        "companyName",
        "contractOrgName",
        "district",
        "phone",
        "lenderName",
        "lenderWitnessName",
        "defaultPenaltyPercent",
        "createdAt",
        "updatedAt"
      ]
    },
    "LoanType": {
      "title": "LoanType",
      "description": "Configurable microfinance loan product definition.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "defaultInterestType": {
          "type": "string",
          "enum": ["flat", "reducing", "fixed_amount"]
        },
        "defaultInterestValue": {
          "type": "number"
        },
        "defaultFrequency": {
          "type": "string",
          "enum": ["weekly", "monthly"]
        },
        "defaultDuration": {
          "type": "number"
        },
        "defaultPenaltyPercent": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "defaultInterestType",
        "defaultInterestValue",
        "defaultFrequency",
        "defaultDuration",
        "defaultPenaltyPercent",
        "createdAt",
        "updatedAt"
      ]
    },
