        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "fullName",
        "phone",
        "street",
        "district",
        "witnessName",
        "witnessPhone",
        "createdAt",
        "updatedAt"
      ]
    },
    "Loan": {
      "title": "Loan",
      "description": "Microfinance loan issued to a customer with interest, schedule frequency, penalty, and balance tracking.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "loanTypeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "principal": {
          "type": "number"
        },
        "interestType": {
          "type": "string",
          "enum": ["flat", "reducing", "fixed_amount"]
        },
        "interestValue": {
          "type": "number"
        },
        "totalInterest": {
          "type": "number"
        },
        "penaltyPercent": {
          "type": "number"
        },
        "penaltyApplied": {
          "type": "number"
        },
        "frequency": {
          "type": "string",
          "enum": ["weekly", "monthly"]
        },
        "durationCount": {
          "type": "number"
        },
        "startDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 30
        },
        "endDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 30
        },
        "totalDue": {
          "type": "number"
        },
        "totalPaidPrincipal": {
          "type": "number"
        },
        "totalPaidInterest": {
          "type": "number"
        },
        "totalPaidPenalty": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed", "overdue"]
        },
        "collateral": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "customerId",
        "loanTypeName",
        "principal",
        "interestType",
        "interestValue",
        "totalInterest",
        "penaltyPercent",
        "penaltyApplied",
        "frequency",
        "durationCount",
        "startDate",
        "endDate",
        "totalDue",
        "totalPaidPrincipal",
        "totalPaidInterest",
        "totalPaidPenalty",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Repayment": {
      "title": "Repayment",
