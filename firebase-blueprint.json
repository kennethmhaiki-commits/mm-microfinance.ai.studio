          "maxLength": 100
        },
        "witnessDistrict": {
          "type": "string",
          "maxLength": 80
        },
        "collateral": {
          "type": "string",
          "maxLength": 200
        },
        "bankName": {
          "type": "string",
          "enum": ["", "NMB", "CRDB", "EXIM", "MWALIMU"]
        },
        "bankAccountNumber": {
          "type": "string",
          "maxLength": 40
        },
        "isGovernmentEmployee": {
          "type": "boolean"
        },
        "checkNumber": {
          "type": "string",
          "maxLength": 40
        },
        "bankMandateActive": {
          "type": "boolean"
