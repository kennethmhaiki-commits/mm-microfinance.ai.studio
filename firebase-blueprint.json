    "BankDebitTransaction": {
      "title": "BankDebitTransaction",
      "description": "Audit log of automatic direct debit or government payroll check-number deduction transactions.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
