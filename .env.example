# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Server-Side Live Bank Direct Debit & Gov Payroll API Gateways
# Leave empty to use built-in verified Gateway Sandbox Mode. Never prefix with VITE_.
# Configure live values via Settings -> Secrets in AI Studio before deploying.
NMB_DIRECT_DEBIT_API_URL=
NMB_DIRECT_DEBIT_API_KEY=
NMB_DIRECT_DEBIT_SECRET_VALUE=
CRDB_DIRECT_DEBIT_API_URL=
CRDB_DIRECT_DEBIT_API_KEY=
CRDB_DIRECT_DEBIT_SECRET_VALUE=
EXIM_DIRECT_DEBIT_API_URL=
EXIM_DIRECT_DEBIT_API_KEY=
EXIM_DIRECT_DEBIT_SECRET_VALUE=
MWALIMU_DIRECT_DEBIT_API_URL=
MWALIMU_DIRECT_DEBIT_API_KEY=
MWALIMU_DIRECT_DEBIT_SECRET_VALUE=
GOV_PAYROLL_CHECKOFF_API_URL=
GOV_PAYROLL_CHECKOFF_API_KEY=
GOV_PAYROLL_CHECKOFF_SECRET_VALUE=

# Optional Server-Side Live SMS Gateway API (NextSMS / Beem Africa / Custom HTTPS SMS API)
# Leave empty to use built-in verified SMS Gateway Sandbox Mode. Never prefix with VITE_.
SMS_GATEWAY_API_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SECRET_VALUE=
SMS_GATEWAY_SENDER_ID=

# Optional Admin Login Credentials (server-side only, never prefix with VITE_)
# Leave empty in preview to claim the admin password on first launch via the setup form.
ADMIN_USERNAME=
ADMIN_PASSWORD=

